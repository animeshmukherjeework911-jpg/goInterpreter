{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug REPL",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug tests in current file's package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.v"]
    }
  ]
}
